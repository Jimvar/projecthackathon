# Copy this to .streamlit/secrets.toml for local testing,
# or set these as secrets in the Streamlit Community Cloud dashboard.
GEMINI_API_KEY = "your-gemini-key"
GEMINI_MODEL   = "gemini-2.5-flash"

# Optional fallback provider — set LLM_PROVIDER="openai" to use these.
# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL   = "gpt-4o-mini"
# LLM_PROVIDER   = "openai"
